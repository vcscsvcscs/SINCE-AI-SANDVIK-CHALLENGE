CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=client-id
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=client-secret
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=tenant-id

# Target user ID (Azure AD Object ID) to send cards to
TARGET_USER_ID=user-object-id-here

# Target user tenant ID (optional, usually same as tenant-id above)
TARGET_USER_TENANT_ID=tenant-id

# Bot ID (optional, usually auto-detected)
BOT_ID=bot-id

# Notification keywords (optional) - comma-separated list
# Only messages containing these keywords will trigger notifications
# Leave empty to send notifications for all messages
# Example: NOTIFICATION_KEYWORDS=urgent,important,help
NOTIFICATION_KEYWORDS=

# Webhook URL for sending adaptive cards to the frontend
# Default: http://localhost:5175/api/webhook
WEBHOOK_URL=http://localhost:5175/api/webhook

